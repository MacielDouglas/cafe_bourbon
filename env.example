# Café Bourbon — variáveis de ambiente (EXEMPLO, sem segredos)
# Copie para .env e preencha. NUNCA commite o .env real.

# Neon PostgreSQL — pooled (runtime) e direct (migrations)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/cafebourbon?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/cafebourbon?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="troque-por-32+-chars-aleatorios"
BETTER_AUTH_URL="http://localhost:3000"

# Groq (opcional — sem ela o assistente roda em modo degradado)
GROQ_API_KEY=""
# Modelo do assistente (opcional; padrão: openai/gpt-oss-120b)
GROQ_MODEL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed (obrigatório para `bun run db:seed` — define a senha da conta OWNER, mínimo 12 chars)
SEED_OWNER_PASSWORD=""
# Libera o seed com NODE_ENV=production (manter "false" fora de ambientes de demonstração)
ALLOW_PRODUCTION_SEED="false"
