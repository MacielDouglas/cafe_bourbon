{
  "name": "cafe_bourbon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bunx --bun prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bun scripts/e2e.ts test",
    "test:e2e:install": "bun scripts/e2e.ts install chromium",
    "test:all": "bun run test && bun run test:e2e",
    "db:seed": "bun prisma/seed.ts",
    "db:migrate": "bunx --bun prisma migrate dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7",
    "@prisma/client": "7",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
